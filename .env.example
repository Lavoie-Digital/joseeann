# Automatisation courriel (SendGrid)
SENDGRID_API_KEY=
# Adresse de réception des notifications (cliente / courtier)
CONTACT_TO=jajomphe@hotmail.com
# Adresse d'envoi vérifiée dans SendGrid
CONTACT_FROM=info@jajomphe.ca
# Adresse du parseur CRM (Parseur -> AVA), fournie par le dev du CRM
CONTACT_PARSEUR=josee-ann.jomphe@in.parseur.com

# Flux Centris
CENTRIS_FEED_URL=https://datadistributionqc.centris.ca/v1/odata/Property
CENTRIS_FEED_TOKEN=
CENTRIS_AGENT_ID=
# Secret du lien de rafraîchissement manuel (/api/revalidate?secret=...).
# Générer avec : node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Laisser vide désactive la route.
REVALIDATE_SECRET=

# Firebase — capsules vidéo (compte de service, côté serveur seulement)
# Après activation de Firestore + Storage : node --env-file=.env scripts/setup-firebase-storage.mjs
FIREBASE_PROJECT_ID=josee-ann
FIREBASE_CLIENT_EMAIL=
# Une seule ligne, entre guillemets, avec les \n littéraux.
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=josee-ann.firebasestorage.app

# Espace privé (/espace-prive) — code d'accès de la cliente
ADMIN_CODE=
# Secret de signature de la session (même commande que REVALIDATE_SECRET)
ADMIN_SESSION_SECRET=
